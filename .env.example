# ---------------------------------------------------------------------------
# MCP server configuration
#
# Copy to .env and adjust. Every value has a working default, so an empty
# environment yields a functional stdio server backed by the in-memory store.
#
# The server reads .env at startup (-env-file, default ".env"), with one rule:
# a variable already present in the real environment ALWAYS wins. The file
# fills gaps; it never overrides. That direction is what makes it safe - a
# stray .env baked into a container image cannot silently replace what your
# orchestrator injected.
#
# A missing file is fine. A malformed line is fatal, and the error names the
# line: silently skipping a line you believed was setting a token is the
# failure this is meant to prevent.
#
# Production secrets still come from a secret manager through the environment,
# not from this file. Pass -env-file "" to disable the feature entirely.
#
# Configuration is validated at startup and a bad value is fatal. Values that
# are legal but questionable in production are logged as warnings instead - run
# `mcp-server -check-config` to see both without starting the server.
#
# Every line marked SECRET must come from a secret manager, never from a file
# in source control.
# ---------------------------------------------------------------------------

# --- Server identity (what MCP clients see during initialize) --------------
MCP_SERVER_NAME=company-mcp-server
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_TITLE=Company Customer Operations
MCP_SERVER_DESCRIPTION=MCP server exposing company customer and order data as tools, resources and prompts.
# MCP_SERVER_INSTRUCTIONS=Free-text guidance returned to the client describing the server as a whole.

# --- Transport --------------------------------------------------------------
# stdio  -> Claude Desktop, MCP Inspector, local development
# http   -> Streamable HTTP for remote deployment (claude.ai, hosted connectors)
MCP_TRANSPORT=stdio

# --- Streamable HTTP transport (only read when MCP_TRANSPORT=http) ----------
MCP_HTTP_ADDR=:8080
MCP_HTTP_PATH=/mcp
# Stateless mode: no server-side session state. Required when running several
# replicas behind a load balancer without sticky sessions. Requires
# CURSOR_SECRET, so that a cursor issued by one replica verifies on another.
MCP_HTTP_STATELESS=false
# Return application/json instead of text/event-stream. Useful behind proxies
# that buffer SSE; disables server-initiated messages.
MCP_HTTP_JSON_RESPONSE=false
MCP_HTTP_SESSION_TIMEOUT=30m
MCP_HTTP_READ_HEADER_TIMEOUT=10s
MCP_HTTP_IDLE_TIMEOUT=120s
MCP_HTTP_SHUTDOWN_TIMEOUT=15s
MCP_HTTP_MAX_REQUEST_BYTES=4194304
MCP_HTTP_MAX_HEADER_BYTES=1048576
# Browser Origin allowlist, comma-separated. Empty means same-origin only,
# which is what a non-browser MCP client needs. There is no wildcard.
MCP_HTTP_ALLOWED_ORIGINS=
# Honour X-Forwarded-For for the client address. Enable ONLY behind a proxy
# that overwrites the header; otherwise any caller can choose its own address
# and defeat per-IP rate limiting.
MCP_HTTP_TRUST_PROXY=false
MCP_HTTP_SECURITY_HEADERS=true
# Prometheus endpoint. Empty disables it.
MCP_METRICS_PATH=/metrics
# SECRET - optional bearer token for the metrics endpoint, so a scraper does
# not need a credential that can read customer data.
MCP_METRICS_TOKEN=

# --- Authentication ---------------------------------------------------------
# none   -> no authentication. stdio only, unless MCP_ALLOW_INSECURE_HTTP=true.
# static -> one shared bearer token. Every caller is the same principal.
# oauth  -> verified JWT access tokens. Required for per-user authorization
#           and for multi-tenancy.
MCP_AUTH_MODE=none
# Set MCP_ALLOW_INSECURE_HTTP=true to acknowledge unauthenticated HTTP.
MCP_ALLOW_INSECURE_HTTP=false

# --- static mode ------------------------------------------------------------
# SECRET - at least 16 characters. Never commit a real value.
MCP_HTTP_BEARER_TOKEN=

# --- oauth mode -------------------------------------------------------------
# The exact `iss` the token must carry.
MCP_OAUTH_ISSUER=
# This server's resource identifier; the token's `aud` must contain it.
# Required: without it, a token minted for another service by the same issuer
# would be accepted here (RFC 8707, the confused-deputy problem).
MCP_OAUTH_AUDIENCE=
# The issuer's public signing keys. https only, except http on loopback.
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_JWKS_REFRESH=15m
# SECRET - HS256 shared secret, at least 32 characters. Mutually exclusive with
# the JWKS URL. For an internal issuer only: with a shared secret this server
# can mint tokens as well as verify them.
MCP_OAUTH_HMAC_SECRET=
# The claim carrying the tenant id.
MCP_OAUTH_TENANT_CLAIM=tenant_id
# Claims that may carry scopes, in priority order.
MCP_OAUTH_SCOPE_CLAIMS=scope,scp,permissions
# Scopes every token must present, beyond the per-operation ones.
MCP_OAUTH_REQUIRED_SCOPES=
# RFC 9728 protected-resource metadata URL, advertised in WWW-Authenticate so a
# client can discover the authorization server.
MCP_OAUTH_RESOURCE_METADATA_URL=

# --- Local principal (stdio, and MCP_AUTH_MODE=none) ------------------------
MCP_LOCAL_SUBJECT=local
MCP_LOCAL_TENANT=default
# Comma- or space-separated. Known scopes: customer:read, customer:search,
# customer:orders:read, customer:update, customer:delete, notification:send.
# Narrow this for a read-only deployment.
MCP_LOCAL_SCOPES=customer:read,customer:search,customer:orders:read,customer:update,customer:delete,notification:send

# --- Tenancy ----------------------------------------------------------------
# When enabled, every caller's tenant comes from its verified token, so
# MCP_AUTH_MODE must be oauth. When disabled, every caller acts inside
# TENANCY_DEFAULT.
TENANCY_ENABLED=false
TENANCY_DEFAULT=default

# --- Authorization ----------------------------------------------------------
# There is no environment variable that grants a permission. Scopes come from
# the caller's token (oauth) or from MCP_LOCAL_SCOPES (static/none), and the
# tool-to-scope mapping lives in internal/authz/policy.go.

# --- Rate limiting ----------------------------------------------------------
# Sustained rates per minute. 0 disables that layer. The first layer to reject
# wins, and a rejection at one layer does not spend the budget of another.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_PRINCIPAL=300
RATE_LIMIT_PER_TENANT=1200
# Stricter budgets for the calls that cannot be undone.
RATE_LIMIT_NOTIFICATIONS=10
RATE_LIMIT_DELETES=5
# 0 derives a burst from the rate.
RATE_LIMIT_BURST=0

# --- Idempotency ------------------------------------------------------------
# Replay protection for send_customer_notification. The store is in process
# memory: with more than one replica, a retry that lands elsewhere finds no
# record and the message is sent twice. See docs/DEPLOYMENT.md.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_MAX_ENTRIES=100000

# --- Pagination -------------------------------------------------------------
# SECRET - HMAC key for pagination cursors. Required when MCP_HTTP_STATELESS is
# true, and must be identical across replicas or cursors fail at random.
CURSOR_SECRET=

# --- Response limits --------------------------------------------------------
# A tool result and a resource body are loaded into a model's context in full,
# so their size is a budget the operator sets.
MAX_TOOL_RESPONSE_BYTES=262144
MAX_RESOURCE_BYTES=262144
# Redact names and email addresses in resource bodies. Off by default, because
# the tools return the same fields; for a deployment where a model may reason
# over accounts but must not see who they belong to.
MASK_PII_IN_RESOURCES=false

# --- Backend ----------------------------------------------------------------
# memory -> built-in seeded store, no external dependency (default)
# http   -> remote REST API described in README section "Backend contract"
BACKEND_MODE=memory
BACKEND_BASE_URL=
# SECRET - never commit a real value.
BACKEND_API_TOKEN=
BACKEND_TIMEOUT=10s
BACKEND_DIAL_TIMEOUT=5s
BACKEND_RESPONSE_HEADER_TIMEOUT=10s
BACKEND_MAX_RESPONSE_BYTES=8388608
# Retries apply only to operations that are safe to repeat. A delete or a
# notification is never retried.
BACKEND_RETRY_ATTEMPTS=3
BACKEND_RETRY_BASE_WAIT=100ms
BACKEND_RETRY_MAX_WAIT=2s
# Consecutive failures that open the circuit breaker. 0 disables it.
BACKEND_CIRCUIT_THRESHOLD=5
BACKEND_CIRCUIT_OPEN_FOR=30s

# --- Observability ----------------------------------------------------------
# debug | info | warn | error. Logs always go to stderr, never stdout: under
# the stdio transport stdout carries the JSON-RPC stream.
LOG_LEVEL=info
# json | text. Use json anywhere a log pipeline reads the output.
LOG_FORMAT=json
METRICS_ENABLED=true
# The security event stream: authentication, authorization, reads, writes,
# deletes and notification sends. Disabling it leaves no security record.
AUDIT_ENABLED=true
# Periodic MCP pings to detect a dead peer. 0 disables them.
MCP_KEEPALIVE=0
